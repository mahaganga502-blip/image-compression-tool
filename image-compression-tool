# Image Compression Tool
# Simple Python project without external libraries
print("===== IMAGE COMPRESSION TOOL =====")
image = [
    "1111111111111111",
    "1111111111111111",
    "1111000011111111",
    "1111000011111111",
    "1111111111111111",
    "1111111111111111",
    "1111110000111111",
    "1111110000111111",
    "1111111111111111",
    "1111111111111111"
]
print("\nOriginal Image:")
for row in image:
    print(row)
# Simple compression using Run-Length Encoding (RLE)
def compress(row):
    result = ""
    count = 1
    for i in range(1, len(row)):
        if row[i] == row[i - 1]:
            count += 1
        else:
            result += row[i - 1] + str(count)
            count = 1
    result += row[-1] + str(count)
    return result
compressed = []
for row in image:
    compressed.append(compress(row))
print("\nCompressed Data:")
for row in compressed:
    print(row)
original_size = sum(len(row) for row in image)
compressed_size = sum(len(row) for row in compressed)
print("\nOriginal Size:", original_size, "characters")
print("Compressed Size:", compressed_size, "characters")
reduction = ((original_size - compressed_size) / original_size) * 100
print("Size Reduction:", round(reduction, 2), "%")


